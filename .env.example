# Renomeie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no git

# ─── INMET ───────────────────────────────────────────────────
# Cadastro gratuito em: https://portal.inmet.gov.br/
INMET_TOKEN=seu_token_aqui

# ─── NASA EarthData (AppEEARS / MODIS) ───────────────────────
# Cadastro gratuito em: https://urs.earthdata.nasa.gov/
NASA_USERNAME=seu_usuario_earthdata
NASA_PASSWORD=sua_senha_earthdata

# ─── Snowflake ───────────────────────────────────────────────
# Se usar PostgreSQL, deixe estas em branco
SNOWFLAKE_ACCOUNT=seu_account_id
SNOWFLAKE_USER=seu_usuario
SNOWFLAKE_PASSWORD=sua_senha
SNOWFLAKE_DATABASE=AGROCLIMA
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# ─── PostgreSQL (fallback) ───────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agroclima
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha
